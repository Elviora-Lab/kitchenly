# ----------------------------------------------------------
# Public (exposed to browser — must be prefixed NEXT_PUBLIC_)
# ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Kitchenly
# Same-origin API. Use an absolute URL only if you front the app with a separate backend.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_ENVIRONMENT=development

# Analytics & 3rd party
# Google Tag Manager container id (GTM-XXXXXXX) — unused; we load GA4 directly (see below).
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX) from GA Admin → Data streams → Web.
# NOT a UA-... id and NOT an API secret. Only loads in production; blank disables GA.
NEXT_PUBLIC_GA_ID=
# Set to "true" to load GA in any environment and tag events with debug_mode so
# they appear in GA4 DebugView (leave blank in production).
NEXT_PUBLIC_GA_DEBUG=
# GA4 Measurement Protocol API secret (Admin → Data Streams → Web → Measurement
# Protocol API secrets). Enables server-side purchase/refund events. Server-only.
GA_API_SECRET=
# GA4 Data API — surfaces live GA metrics in /admin/analytics. Numeric property
# id (Admin → Property Settings) + a Google Cloud service account (JSON key)
# granted "Viewer" on the GA property. Keep the private key's \n escapes.
GA_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=
# Meta (Facebook) Pixel. Defaults to the Kitchenly pixel in code if left blank.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_SENTRY_DSN=

# OAuth (client IDs only — browser-safe)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe publishable key — browser-safe; pair with STRIPE_SECRET_KEY below
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------------------------------------------
# Server-only (NEVER prefix with NEXT_PUBLIC_)
# ----------------------------------------------------------
API_URL=

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-strong-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-strong-random-string
NEXTAUTH_SECRET=replace-me
GOOGLE_CLIENT_SECRET=

# --- DATABASE -----------------------------------------------------------
# Any Postgres works (local, Supabase, Neon, Render, RDS).
#
# Local Postgres:
#   postgresql://postgres:postgres@localhost:5432/kitchenly?schema=public
#
# Supabase (recommended) — copy the SESSION POOLER string from:
#   Supabase Dashboard → Connect → Connection string → Session pooler
# It looks like:
#   postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# The Session pooler (port 5432) works for both runtime AND migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kitchenly?schema=public

# Optional. Only needed when DATABASE_URL points to a TRANSACTION pooler
# (Supabase port 6543 — required at high concurrency); migrations bypass it
# via DIRECT_URL. With the Session pooler URL above, leave this blank.
#
# NOTE: if you DO use the transaction pooler (port 6543), you MUST append
# `?pgbouncer=true` to DATABASE_URL. Without it, Prisma's named prepared
# statements break across pooled backends → `prepared statement "sN" does
# not exist` (Postgres 26000). Do NOT put pgbouncer=true on DIRECT_URL.
DIRECT_URL=

# Cache + queues (optional — app gracefully degrades when unset)
REDIS_URL=

# Email — Resend
RESEND_API_KEY=

# Payments — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage — S3 / R2 / any S3-compatible
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# AI (skin assessment)
OPENAI_API_KEY=

# Meta Conversions API (server-side events). Get the token from Events Manager →
# Settings → Conversions API. Leave blank to disable server-side tracking.
META_CAPI_ACCESS_TOKEN=
# Optional: routes CAPI events to Events Manager → Test events while wiring up.
META_CAPI_TEST_EVENT_CODE=

# Meta Marketing API — read-only ad performance dashboard at /admin/ads.
# System User token with the `ads_read` permission (Business Settings → System
# Users → Generate token), plus your ad account id (digits, with or without the
# act_ prefix). Both blank ⇒ the dashboard shows a setup card instead.
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# Observability
# Set NEXT_PUBLIC_SENTRY_DSN (above) to enable error reporting at runtime.
# The three below are only needed in CI/production to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
